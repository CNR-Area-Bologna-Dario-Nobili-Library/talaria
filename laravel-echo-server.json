
{
    "authHost": "https://talaria.local",
    "host": "0.0.0.0",
    "port": "6001",
    "protocol": "https",
    "sslCertPath": "./ssl/talaria.local.pem",
    "sslKeyPath": "./ssl/talaria.local-key.pem",
    "subscribers": {
      "http": true,
      "redis": true
    },
    "database": "redis",
    "databaseConfig": {
      "redis": {
        "host": "127.0.0.1",
        "port": "6379",
        "password": null,
        "keyPrefix": "talaria_database_"

      }
    },
    "apiOriginAllow": {
      "allowCors": true,
      "allowOrigin": "*",
      "allowMethods": "GET, POST",
      "allowHeaders": "Origin, Content-Type, Authorization, X-Requested-With, Accept"
    }
  }